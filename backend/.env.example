# Groq / Grok Cloud LLM Configuration (Default Ultra-Fast Provider)
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_groq_or_grok_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Gemini API Configuration (Optional Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_KEY_NAME=AIBI_API
GEMINI_PROJECT_NAME=projects/your_project_id
GEMINI_PROJECT_NUMBER=your_project_number
GEMINI_MODEL=gemini-3.6-flash
